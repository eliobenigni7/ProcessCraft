* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.vectorcraft text eol=lf
*.svg text eol=lf
*.ico binary

# Fixtures and font manifests pin exact source bytes with SHA-256 hashes.
tests/fixtures/** -text whitespace=-trailing-space,cr-at-eol
assets/fonts/** -text whitespace=-trailing-space,cr-at-eol
*.pdf binary
*.png binary
*.ttf binary
*.otf binary
*.figcraft binary
