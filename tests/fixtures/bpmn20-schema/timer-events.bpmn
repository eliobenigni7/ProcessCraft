<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:tns="urn:processcraft:test" id="defs" targetNamespace="urn:processcraft:test">
  <process id="process" isExecutable="false">
    <startEvent id="start"><timerEventDefinition id="startTimer"><timeDuration>PT5M</timeDuration></timerEventDefinition></startEvent>
    <task id="work" name="Work"/>
    <boundaryEvent id="boundary" attachedToRef="tns:work" cancelActivity="false"><timerEventDefinition id="boundaryTimer"><timeCycle>R3/PT5M</timeCycle></timerEventDefinition></boundaryEvent>
    <endEvent id="end"><terminateEventDefinition id="terminate"/></endEvent>
    <sequenceFlow id="flow" sourceRef="start" targetRef="work"/>
  </process>
</definitions>
