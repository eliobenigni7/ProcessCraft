      <bpmn:endEvent id="Sub_A_end"/>
      <bpmn:sequenceFlow id="Sub_A_flow" sourceRef="Sub_A_start" targetRef="Sub_A_end"/>
    </bpmn:subChoreography>
    <bpmn:callChoreography id="Call" name="Call global choreography" initiatingParticipantRef="tns:A" calledChoreographyRef="tns:Global">
      <bpmn:participantRef>tns:A</bpmn:participantRef>
      <bpmn:participantRef>tns:B</bpmn:participantRef>
      <bpmn:participantAssociation id="Assoc_GA">
        <bpmn:innerParticipantRef>tns:GA</bpmn:innerParticipantRef>
        <bpmn:outerParticipantRef>tns:A</bpmn:outerParticipantRef>
      </bpmn:participantAssociation>
      <bpmn:participantAssociation id="Assoc_GB">
        <bpmn:innerParticipantRef>tns:GB</bpmn:innerParticipantRef>
        <bpmn:outerParticipantRef>tns:B</bpmn:outerParticipantRef>
      </bpmn:participantAssociation>
    </bpmn:callChoreography>
    <bpmn:endEvent id="End"/>
