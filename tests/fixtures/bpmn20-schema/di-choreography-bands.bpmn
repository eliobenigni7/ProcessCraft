  <bpmn:message id="Message_AB" name="Order"/>
  <bpmn:message id="Message_CA" name="Receipt"/>
  <bpmn:choreography id="Choreography" name="Order choreography">
    <bpmn:participant id="A" name="Buyer"/>
    <bpmn:participant id="B" name="Seller">
      <bpmn:participantMultiplicity id="B_multiplicity" minimum="1" maximum="3"/>
    </bpmn:participant>
    <bpmn:participant id="C" name="Carrier"/>
    <bpmn:messageFlow id="MF_AB" sourceRef="tns:A" targetRef="tns:B" messageRef="tns:Message_AB"/>
    <bpmn:messageFlow id="MF_CA" sourceRef="tns:A" targetRef="tns:C" messageRef="tns:Message_CA"/>
    <bpmn:startEvent id="Start"/>
    <bpmn:exclusiveGateway id="Gateway"/>
    <bpmn:choreographyTask id="Task_AB" name="Task_AB" initiatingParticipantRef="tns:A">
      <bpmn:participantRef>tns:A</bpmn:participantRef>
      <bpmn:participantRef>tns:B</bpmn:participantRef>
      <bpmn:messageFlowRef>tns:MF_AB</bpmn:messageFlowRef>
    </bpmn:choreographyTask>
    <bpmn:choreographyTask id="Task_CA" name="Task_CA" initiatingParticipantRef="tns:A">
      <bpmn:participantRef>tns:C</bpmn:participantRef>
      <bpmn:participantRef>tns:A</bpmn:participantRef>
      <bpmn:messageFlowRef>tns:MF_CA</bpmn:messageFlowRef>
    </bpmn:choreographyTask>
    <bpmn:subChoreography id="Sub_B" name="Sub_B" initiatingParticipantRef="tns:B">
      <bpmn:participantRef>tns:A</bpmn:participantRef>
      <bpmn:participantRef>tns:B</bpmn:participantRef>
      <bpmn:participantRef>tns:C</bpmn:participantRef>
      <bpmn:startEvent id="Sub_B_start"/>
      <bpmn:endEvent id="Sub_B_end"/>
      <bpmn:sequenceFlow id="Sub_B_flow" sourceRef="Sub_B_start" targetRef="Sub_B_end"/>
    </bpmn:subChoreography>
    <bpmn:subChoreography id="Sub_A" name="Sub_A" initiatingParticipantRef="tns:A">
      <bpmn:participantRef>tns:A</bpmn:participantRef>
      <bpmn:participantRef>tns:B</bpmn:participantRef>
      <bpmn:participantRef>tns:C</bpmn:participantRef>
