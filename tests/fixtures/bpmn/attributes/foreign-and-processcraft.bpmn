<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:pc="urn:processcraft:attributes:1" targetNamespace="urn:processcraft:fixture:attributes" id="definitions">
  <process id="process" isExecutable="false">
    <startEvent id="start"/>
    <userTask id="review" name="Review invoice">
      <extensionElements>
        <camunda:properties><camunda:property name="priority" value="high"/></camunda:properties>
        <camunda:taskListener event="create" class="org.example.Listener"/>
        <pc:attributes>
          <pc:attribute definition="11111111-1111-4111-8111-111111111111" name="Cost" type="currency" unit="EUR">12.50</pc:attribute>
          <pc:attribute definition="22222222-2222-4222-8222-222222222222" name="Effort" type="duration">PT90M</pc:attribute>
          <pc:attribute definition="33333333-3333-4333-8333-333333333333" name="Risk" type="enum">High</pc:attribute>
          <pc:attribute definition="44444444-4444-4444-8444-444444444444" name="Consulted" type="dictionaryRef" dictionaryKind="role"><pc:ref entry="99999999-9999-4999-8999-999999999999" name="Finance lead"/><pc:ref name="External auditor"/></pc:attribute>
        </pc:attributes>
      </extensionElements>
    </userTask>
    <endEvent id="end"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="review"/>
    <sequenceFlow id="flow2" sourceRef="review" targetRef="end"/>
  </process>
</definitions>
