<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs" targetNamespace="urn:m3-gateways"><process id="p" isExecutable="false"><startEvent id="s"/><exclusiveGateway id="xor" name="Route" gatewayDirection="Diverging" default="xf_default"/><task id="t1" name="One"/><task id="t2" name="Two"/><inclusiveGateway id="inc" name="Any" gatewayDirection="Diverging" default="of_default"/><task id="t3" name="Three"/><task id="t4" name="Four"/><parallelGateway id="par" name="Join" gatewayDirection="Converging"/><task id="t5" name="Five"/><eventBasedGateway id="evx" name="Wait" gatewayDirection="Unspecified" instantiate="false" eventGatewayType="Exclusive"/><receiveTask id="r1" name="R1"/><receiveTask id="r2" name="R2"/><eventBasedGateway id="evp" name="Start on all" gatewayDirection="Mixed" instantiate="true" eventGatewayType="Parallel"/><receiveTask id="r3" name="R3"/><receiveTask id="r4" name="R4"/><sequenceFlow id="f_s" sourceRef="s" targetRef="xor"/><sequenceFlow id="xf_default" sourceRef="xor" targetRef="t1"/><sequenceFlow id="xf_cond" sourceRef="xor" targetRef="t2"><conditionExpression>amount &gt; 10</conditionExpression></sequenceFlow><sequenceFlow id="f_t1" sourceRef="t1" targetRef="inc"/><sequenceFlow id="of_default" sourceRef="inc" targetRef="t3"/><sequenceFlow id="of_cond" sourceRef="inc" targetRef="t4"><conditionExpression>urgent</conditionExpression></sequenceFlow><sequenceFlow id="f_t2" sourceRef="t2" targetRef="par"/><sequenceFlow id="f_t3" sourceRef="t3" targetRef="par"/><sequenceFlow id="f_par" sourceRef="par" targetRef="t5"/><sequenceFlow id="f_t5" sourceRef="t5" targetRef="evx"/><sequenceFlow id="f_evx1" sourceRef="evx" targetRef="r1"/><sequenceFlow id="f_evx2" sourceRef="evx" targetRef="r2"/><sequenceFlow id="f_evp1" sourceRef="evp" targetRef="r3"/><sequenceFlow id="f_evp2" sourceRef="evp" targetRef="r4"/></process></definitions>
