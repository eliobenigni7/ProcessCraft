<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:v="urn:vendor" xmlns:t="urn:common" targetNamespace="urn:common" id="definitions">
  <process id="process">
    <documentation id="documentation" textFormat="text/plain">before<v:detail xmlns:v="urn:shadow" ref="v:item">inside</v:detail>after<!--note--><?inspect harmless?></documentation>
    <documentation/>
    <scriptTask id="task"></scriptTask>
    <task id="next"/>
    <sequenceFlow id="flow" sourceRef="task" targetRef="next"></sequenceFlow>
    <textAnnotation id="note"><text>plain</text></textAnnotation>
  </process>
</definitions>
