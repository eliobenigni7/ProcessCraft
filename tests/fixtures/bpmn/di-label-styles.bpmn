<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:tns="urn:di-endpoints" xmlns:bd="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="urn:di-endpoints">
 <process id="process" isExecutable="false"><task id="a"/><task id="b"/><sequenceFlow id="flow" sourceRef="a" targetRef="b"/><textAnnotation id="note"><text>Note</text></textAnnotation><association id="assoc" sourceRef="tns:note" targetRef="tns:flow"/></process>
 <bd:BPMNDiagram id="diagram" documentation="Diagram notes" resolution="96"><bd:BPMNPlane id="plane" bpmnElement="tns:process"><bd:BPMNShape id="shapeA" bpmnElement="tns:a" isHorizontal="false" isMarkerVisible="true"><dc:Bounds x="0" y="0" width="100" height="80"/><bd:BPMNLabel id="label" labelStyle="tns:labelStyle"/></bd:BPMNShape><bd:BPMNShape id="shapeB" bpmnElement="tns:b"><dc:Bounds x="200" y="0" width="100" height="80"/></bd:BPMNShape><bd:BPMNShape id="shapeNote" bpmnElement="tns:note"><dc:Bounds x="80" y="120" width="100" height="50"/></bd:BPMNShape><bd:BPMNEdge id="edgeFlow" bpmnElement="tns:flow"><di:waypoint x="100" y="40"/><di:waypoint x="200" y="40"/></bd:BPMNEdge><bd:BPMNEdge id="edgeAssoc" bpmnElement="tns:assoc" sourceElement="tns:shapeNote" targetElement="tns:edgeFlow"><di:waypoint x="130" y="120"/><di:waypoint x="150" y="40"/></bd:BPMNEdge></bd:BPMNPlane><bd:BPMNLabelStyle id="labelStyle"><dc:Font name="Arial" size="12" isBold="true" isItalic="false"/></bd:BPMNLabelStyle></bd:BPMNDiagram>
</definitions>
