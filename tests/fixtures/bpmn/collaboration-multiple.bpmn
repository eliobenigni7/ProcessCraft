  <messageFlowAssociation innerMessageFlowRef="ext:Flow" outerMessageFlowRef="t:Request"/>
  <correlationKey id="Key"/><choreographyRef>ext:Choreography</choreographyRef><conversationLink id="Link" sourceRef="t:Sub" targetRef="t:Buyer"/>
 </collaboration>
 <process id="Process"/>
 <endPoint id="Endpoint"/>
 <partnerRole name="Provider"><participantRef>t:Seller</participantRef></partnerRole>
 <globalConversation id="Global" name="Shared"/>
